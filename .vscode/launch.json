{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current Main",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": ["${input:getPythonArgs}"]
        },
        {
            "name": "Python Debugger: Run File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "getPythonArgs",
            "type": "pickString",
            "description": "Select or type arguments for this run:",
            "options": [
                "",
                "--rebuild-dist",
                "--reinstall",
            ],
            "default": ""
        }
    ]
}